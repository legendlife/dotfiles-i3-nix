#!/run/current-system/sw/bin/bash

# Expand tilde in paths
SHELL_NIX_PATH="${HOME}/dotfiles/tools/kintamahound/shell.nix"
KINTAMAHOUND_PATH="${HOME}/dotfiles/tools/kintamahound/scanner.py"

# Check if the shell.nix file exists
if [ ! -f "$SHELL_NIX_PATH" ]; then
    echo "Error: shell.nix file not found at $SHELL_NIX_PATH"
    exit 1
fi

# Check if the nmappy script exists
if [ ! -f "$KINTAMAHOUND_PATH" ]; then
    echo "Error: kintamahound not found at $KINTAMAHOUND_PATH"
    exit 1
fi

# Run nmappy in the nix-shell environment
nix-shell "$SHELL_NIX_PATH" --run "python $KINTAMAHOUND_PATH $*"
